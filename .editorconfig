root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.ts]
indent_style = tab
indent_size = 2
tab_width = 2

[*.js]
indent_style = tab
indent_size = 2
tab_width = 2

[*.html]
indent_style = tab
indent_size = 2
tab_width = 2

[*.css]
indent_style = tab
indent_size = 2
tab_width = 2

[*.json]
indent_style = tab
indent_size = 2
tab_width = 2

[*.{yml,yaml}]
indent_style = tab
indent_size = 2
tab_width = 2

[*.md]
indent_style = tab
indent_size = 2
tab_width = 2

[*.nix]
indent_style = space
indent_size = 2
tab_width = 2
